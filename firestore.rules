rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(userId, role) {
      return isOwner(userId) &&
        get(/databases/$(database)/documents/users/$(userId)).data.role == role;
    }

    function isSeller(userId) {
      return hasRole(userId, 'shopOwner') || hasRole(userId, 'streetVendor');
    }

    function isCustomer(userId) {
      return hasRole(userId, 'customer');
    }

    function validReceiptSnapshot(receipt, source) {
      return receipt is map &&
        receipt.keys().hasAll(['id', 'store', 'items', 'createdAt', 'paymentMode']) &&
        receipt.keys().hasOnly(['id', 'store', 'items', 'createdAt', 'paymentMode']) &&
        receipt.id == source.id &&
        receipt.store == source.store && receipt.items == source.items &&
        receipt.createdAt == source.createdAt && receipt.paymentMode == source.paymentMode;
    }

    function validClaimDocument(data) {
      return data.keys().hasAll(['ownerUid', 'sourceBillId', 'receipt', 'expiresAt', 'status']) &&
        data.keys().hasOnly(['ownerUid', 'sourceBillId', 'receipt', 'expiresAt', 'status', 'claimedBy', 'claimedAt']) &&
        data.ownerUid is string && data.sourceBillId is string &&
        data.receipt is map && data.expiresAt is timestamp &&
        data.status in ['open', 'claimed'] &&
        (
          (data.status == 'open' && !data.keys().hasAny(['claimedBy', 'claimedAt'])) ||
          (data.status == 'claimed' &&
            data.keys().hasAll(['claimedBy', 'claimedAt']) &&
            data.claimedBy is string && data.claimedBy.size() > 0 &&
            data.claimedAt is timestamp)
        );
    }

    function matchingClaimAfter(ownerUid, billId, data) {
      let claim = getAfter(/databases/$(database)/documents/receiptClaims/$(data.claimDigest)).data;
      return claim.status == 'claimed' &&
        claim.claimedBy == data.recipientUid &&
        claim.ownerUid == ownerUid && claim.sourceBillId == billId &&
        claim.receipt == data.receipt;
    }

    function matchingOpenClaimBefore(ownerUid, billId, data) {
      let claim = get(/databases/$(database)/documents/receiptClaims/$(data.claimDigest)).data;
      return claim.status == 'open' && claim.ownerUid == ownerUid &&
        claim.sourceBillId == billId && claim.receipt == data.receipt;
    }

    function matchingCopyAfter(customerUid, ownerUid, billId, receipt) {
      let copy = getAfter(/databases/$(database)/documents/users/$(customerUid)/claimedReceipts/$(ownerUid)/bills/$(billId)).data;
      return copy.recipientUid == customerUid && copy.ownerUid == ownerUid &&
        copy.sourceBillId == billId && copy.receipt == receipt;
    }

    // Role is a user-selected app mode (customer, shopOwner, streetVendor), not an admin role.
    function isValidRole(role) {
      return role is string && (role == 'customer' || role == 'shopOwner' || role == 'streetVendor');
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['name', 'role', 'updatedAt']) &&
             data.keys().hasOnly(['name', 'email', 'city', 'role', 'shopName', 'shopCategory', 'shopAddress', 'vendorName', 'vendorCategory', 'updatedAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             isValidRole(data.role) &&
             data.updatedAt is timestamp &&
             (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 100)) &&
             (!data.keys().hasAny(['city']) || (data.city is string && data.city.size() <= 100)) &&
             (!data.keys().hasAny(['shopName']) || (data.shopName is string && data.shopName.size() <= 100)) &&
             (!data.keys().hasAny(['shopCategory']) || (data.shopCategory is string && data.shopCategory.size() <= 50)) &&
             (!data.keys().hasAny(['shopAddress']) || (data.shopAddress is string && data.shopAddress.size() <= 200)) &&
             (!data.keys().hasAny(['vendorName']) || (data.vendorName is string && data.vendorName.size() <= 100)) &&
             (!data.keys().hasAny(['vendorCategory']) || (data.vendorCategory is string && data.vendorCategory.size() <= 50));
    }

    function isProfileUpdateAllowed(existingData, newData) {
      // Preserve existing role and prevent unauthorized injection of privileged system/admin fields
      return newData.role == existingData.role &&
             !newData.keys().hasAny(['admin', 'balance', 'plan', 'creditLimit']) &&
             isValidProfile(newData);
    }

    function isValidBillItem(item) {
      return item is map &&
             item.keys().size() == 3 &&
             item.name is string && item.name.size() > 0 && item.name.size() <= 100 &&
             item.quantity is int && item.quantity > 0 && item.quantity <= 1000 &&
             item.unitPrice is number && item.unitPrice >= 0 && item.unitPrice <= 10000000;
    }

    function hasValidBillItems(items) {
      return items is list
          && items.size() >= 1
          && items.size() <= 10
          && isValidBillItem(items[0])
          && (items.size() < 2 || isValidBillItem(items[1]))
          && (items.size() < 3 || isValidBillItem(items[2]))
          && (items.size() < 4 || isValidBillItem(items[3]))
          && (items.size() < 5 || isValidBillItem(items[4]))
          && (items.size() < 6 || isValidBillItem(items[5]))
          && (items.size() < 7 || isValidBillItem(items[6]))
          && (items.size() < 8 || isValidBillItem(items[7]))
          && (items.size() < 9 || isValidBillItem(items[8]))
          && (items.size() < 10 || isValidBillItem(items[9]));
    }

    function isValidBill(data) {
      return data.keys().hasAll(['id', 'store', 'items', 'createdAt', 'paymentMode']) &&
             data.keys().hasOnly(['id', 'store', 'items', 'createdAt', 'paymentMode', 'customerPhone', 'isUdhaar', 'isSettled', 'isSaved']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 50 &&
             data.store is string && data.store.size() > 0 && data.store.size() <= 100 &&
             data.paymentMode is string && data.paymentMode.size() > 0 && data.paymentMode.size() <= 50 &&
             data.createdAt is timestamp &&
             hasValidBillItems(data.items) &&
             (!data.keys().hasAny(['customerPhone']) || (data.customerPhone is string && data.customerPhone.size() <= 30)) &&
             (!data.keys().hasAny(['isUdhaar']) || data.isUdhaar is bool) &&
             (!data.keys().hasAny(['isSettled']) || data.isSettled is bool) &&
             (!data.keys().hasAny(['isSaved']) || data.isSaved is bool);
    }

    function isBillUpdateAllowed(existingData, newData) {
      return newData.id == existingData.id &&
             newData.store == existingData.store &&
             newData.items == existingData.items &&
             newData.createdAt == existingData.createdAt &&
             newData.paymentMode == existingData.paymentMode &&

             // customerPhone cannot be added, removed, or changed.
             (existingData.keys().hasAny(['customerPhone']) ==
              newData.keys().hasAny(['customerPhone'])) &&
             (!existingData.keys().hasAny(['customerPhone']) ||
              newData.customerPhone == existingData.customerPhone) &&

             // isUdhaar cannot be added, removed, or changed.
             (existingData.keys().hasAny(['isUdhaar']) ==
              newData.keys().hasAny(['isUdhaar'])) &&
             (!existingData.keys().hasAny(['isUdhaar']) ||
              newData.isUdhaar == existingData.isUdhaar) &&

             // isSaved: unchanged or false -> true only.
             (existingData.keys().hasAny(['isSaved']) ==
              newData.keys().hasAny(['isSaved'])) &&
             (!existingData.keys().hasAny(['isSaved']) ||
              newData.isSaved == existingData.isSaved ||
              (existingData.isSaved == false &&
               newData.isSaved == true)) &&

             // isSettled: unchanged or false -> true only.
             (existingData.keys().hasAny(['isSettled']) ==
              newData.keys().hasAny(['isSettled'])) &&
             (!existingData.keys().hasAny(['isSettled']) ||
              newData.isSettled == existingData.isSettled ||
              (existingData.isSettled == false &&
               newData.isSettled == true)) &&

             isValidBill(newData);
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['title', 'category', 'amount', 'createdAt']) &&
             data.keys().hasOnly(['title', 'category', 'amount', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
             data.amount is number && data.amount >= 0 && data.amount <= 10000000 &&
             data.createdAt is timestamp;
    }

    function isValidSavedShop(data) {
      return data.keys().hasAll(['shopName']) &&
             data.keys().hasOnly(['shopName', 'updatedAt']) &&
             data.shopName is string && data.shopName.size() > 0 && data.shopName.size() <= 100 &&
             (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidProfile(request.resource.data);
      allow update: if isOwner(userId) && isProfileUpdateAllowed(resource.data, request.resource.data);
      // Deny client profile deletion until cascade-delete handling is implemented.
      allow delete: if false;

      match /bills/{billId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && billId == request.resource.data.id && isValidBill(request.resource.data);
        allow update: if isOwner(userId) && billId == request.resource.data.id && isBillUpdateAllowed(resource.data, request.resource.data);
        // Financial bill deletion policy: DISALLOWED to preserve financial audit trail & integrity.
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidExpense(request.resource.data);
        // Expense update policy: DISALLOWED because expense editing is not in app features.
        allow update: if false;
        // Financial expense deletion policy: DISALLOWED to preserve financial audit trail.
        allow delete: if false;
      }

      match /savedShops/{shopId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSavedShop(request.resource.data);
        allow update: if isOwner(userId) && isValidSavedShop(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /claimedReceipts/{ownerUid}/bills/{billId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isCustomer(userId) &&
          request.resource.data.keys().hasAll(['recipientUid', 'ownerUid', 'sourceBillId', 'receipt', 'claimedAt', 'claimDigest']) &&
          request.resource.data.keys().hasOnly(['recipientUid', 'ownerUid', 'sourceBillId', 'receipt', 'claimedAt', 'claimDigest']) &&
          request.resource.data.recipientUid == userId && request.resource.data.ownerUid == ownerUid &&
          request.resource.data.sourceBillId == billId && request.resource.data.claimedAt == request.time &&
          request.resource.data.claimDigest is string && request.resource.data.claimDigest.size() == 64 &&
          request.resource.data.receipt.id == billId &&
          matchingOpenClaimBefore(ownerUid, billId, request.resource.data) &&
          matchingClaimAfter(ownerUid, billId, request.resource.data);
        allow update, delete: if false;
      }

      match /claimedReceiptsIndex/{receiptKey} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isCustomer(userId) &&
          request.resource.data.keys().hasAll(['recipientUid', 'ownerUid', 'sourceBillId', 'receipt', 'claimedAt', 'claimDigest']) &&
          request.resource.data.keys().hasOnly(['recipientUid', 'ownerUid', 'sourceBillId', 'receipt', 'claimedAt', 'claimDigest']) &&
          request.resource.data.recipientUid == userId && request.resource.data.ownerUid is string &&
          request.resource.data.sourceBillId is string &&
          receiptKey == request.resource.data.ownerUid + '~' + request.resource.data.sourceBillId &&
          request.resource.data.claimedAt == request.time &&
          request.resource.data.claimDigest is string && request.resource.data.claimDigest.size() == 64 &&
          matchingOpenClaimBefore(request.resource.data.ownerUid, request.resource.data.sourceBillId, request.resource.data) &&
          matchingCopyAfter(userId, request.resource.data.ownerUid, request.resource.data.sourceBillId, request.resource.data.receipt) &&
          matchingClaimAfter(request.resource.data.ownerUid, request.resource.data.sourceBillId, request.resource.data);
        allow update, delete: if false;
      }
    }

    match /receiptClaims/{digest} {
      allow get: if isAuthenticated() && (
        (!exists(/databases/$(database)/documents/receiptClaims/$(digest)) &&
          isSeller(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/receiptClaims/$(digest)) && (
          resource.data.ownerUid == request.auth.uid ||
          (resource.data.status == 'open' && request.time < resource.data.expiresAt) ||
          (resource.data.status == 'claimed' && resource.data.claimedBy == request.auth.uid)
        ))
      );
      allow list: if false;
      allow create: if isAuthenticated() && isSeller(request.auth.uid) &&
        validClaimDocument(request.resource.data) &&
        request.resource.data.status == 'open' &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(24, 'h') &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/bills/$(request.resource.data.sourceBillId)) &&
        validReceiptSnapshot(
          request.resource.data.receipt,
          get(/databases/$(database)/documents/users/$(request.auth.uid)/bills/$(request.resource.data.sourceBillId)).data
        );
      allow update: if (
        isAuthenticated() && isCustomer(request.auth.uid) &&
        resource.data.status == 'open' && request.time < resource.data.expiresAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedBy', 'claimedAt']) &&
        request.resource.data.status == 'claimed' &&
        request.resource.data.claimedBy == request.auth.uid &&
        request.resource.data.claimedAt == request.time &&
        validClaimDocument(request.resource.data) &&
        matchingCopyAfter(request.auth.uid, resource.data.ownerUid, resource.data.sourceBillId, resource.data.receipt) &&
        matchingClaimIndexAfter(request.auth.uid, resource.data.ownerUid, resource.data.sourceBillId, resource.data.receipt)
      );
      allow delete: if false;
    }

    function matchingClaimIndexAfter(customerUid, ownerUid, billId, receipt) {
      let index = getAfter(/databases/$(database)/documents/users/$(customerUid)/claimedReceiptsIndex/$(ownerUid + '~' + billId)).data;
      return index.recipientUid == customerUid && index.ownerUid == ownerUid &&
        index.sourceBillId == billId && index.receipt == receipt;
    }
  }
}
